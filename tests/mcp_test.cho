import std.buffer;
import std.bytes;
import std.test;
import mcp;
import msg;

fn same[&h](heap: &!h Heap, b: buffer.Buffer, want: &static [byte]) -> [heap] int {
    borrow b as &bb in {
        test.assert(bytes.equal(buffer.bytes(bb), want));
    }
    buffer.drop(heap, b);
    return 0;
}

fn test_the_requests_of_both_eras[&h](heap: &!h Heap) -> [heap] int {
    same(heap, mcp.discover(heap, 1), "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"server/discover\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientInfo\":{\"name\":\"cancho-agent\",\"version\":\"0.1.0\"},\"io.modelcontextprotocol/clientCapabilities\":{}}}}\n");
    same(heap, mcp.initialize(heap, 1), "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-11-25\",\"capabilities\":{},\"clientInfo\":{\"name\":\"cancho-agent\",\"version\":\"0.1.0\"}}}\n");
    same(heap, mcp.initialized(heap), "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}\n");
    same(heap, mcp.tools_list(heap, 2, true, ""), "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientInfo\":{\"name\":\"cancho-agent\",\"version\":\"0.1.0\"},\"io.modelcontextprotocol/clientCapabilities\":{}}}}\n");
    same(heap, mcp.tools_list(heap, 2, false, ""), "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{}}\n");
    same(heap, mcp.tools_list(heap, 3, false, "x"), "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/list\",\"params\":{\"cursor\":\"x\"}}\n");
    same(heap, mcp.tools_list(heap, 3, false, "page-2"), "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/list\",\"params\":{\"cursor\":\"page-2\"}}\n");
    same(heap, mcp.tools_call(heap, 4, false, "add", "{\"a\":1,\"b\":2}"), "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/call\",\"params\":{\"name\":\"add\",\"arguments\":{\"a\":1,\"b\":2}}}\n");
    same(heap, mcp.tools_call(heap, 5, true, "add", ""), "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientInfo\":{\"name\":\"cancho-agent\",\"version\":\"0.1.0\"},\"io.modelcontextprotocol/clientCapabilities\":{}},\"name\":\"add\",\"arguments\":{}}}\n");
    same(heap, mcp.tools_call(heap, 6, false, "x\"y", "not an object"), "{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"tools/call\",\"params\":{\"name\":\"x\\\"y\",\"arguments\":{}}}\n");
    return 0;
}

fn kind_of[&h](heap: &!h Heap, output: &static [byte], id: int) -> [heap] int {
    let (k, line) = mcp.find_response(heap, output, id);
    buffer.drop(heap, line);
    return k;
}

fn test_the_answer_to_a_request_is_found_among_what_the_server_writes[&h](heap: &!h Heap) -> [heap] int {
    let out = "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/message\",\"params\":{}}\n{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"x\":1}}\nnot json at all\n{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"resultType\":\"complete\"}}\n{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}\n";
    test.assert_eq(kind_of(heap, out, 1), 1);
    test.assert_eq(kind_of(heap, out, 2), 1);
    test.assert_eq(kind_of(heap, out, 3), 2);
    test.assert_eq(kind_of(heap, out, 4), 0);
    test.assert_eq(kind_of(heap, "", 1), 0);
    test.assert_eq(kind_of(heap, "{\"id\":1}\n", 1), 0);
    test.assert_eq(kind_of(heap, "{\"id\":\"1\",\"result\":{}}\n", 1), 0);
    // the first answer to an id counts
    let (k, line) = mcp.find_response(heap, "{\"id\":1,\"result\":{\"a\":1}}\n{\"id\":1,\"error\":{\"code\":1,\"message\":\"x\"}}\n", 1);
    test.assert_eq(k, 1);
    borrow line as &lb in {
        test.assert(bytes.equal(buffer.bytes(lb), "{\"id\":1,\"result\":{\"a\":1}}"));
    }
    buffer.drop(heap, line);
    // a last line with no newline is a line
    test.assert_eq(kind_of(heap, "{\"id\":7,\"result\":{}}", 7), 1);
    return 0;
}

fn test_an_error_is_said_with_its_code[&h](heap: &!h Heap) -> [heap] int {
    let e = mcp.error_text(heap, "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}");
    same(heap, e, "-32601: Method not found");
    let e2 = mcp.error_text(heap, "{\"id\":3,\"error\":{\"message\":\"no code\"}}");
    same(heap, e2, "no code");
    let e3 = mcp.error_text(heap, "{\"id\":3,\"result\":{}}");
    same(heap, e3, "");
    return 0;
}

fn test_a_page_of_tools_becomes_neutral_tools[&h](heap: &!h Heap) -> [heap] int {
    let line = "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"resultType\":\"complete\",\"tools\":[{\"name\":\"get_weather\",\"title\":\"Weather\",\"description\":\"Get the weather\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"location\":{\"type\":\"string\"}},\"required\":[\"location\"]},\"icons\":[]},{\"name\":\"ping\",\"inputSchema\":{\"type\":\"object\",\"additionalProperties\":false}},{\"description\":\"no name\"},{\"name\":\"odd\",\"description\":\"d\",\"inputSchema\":null}],\"nextCursor\":\"p2\",\"ttlMs\":300000}}";
    let (tools, cursor) = mcp.tools_page(heap, line, false);
    same(heap, tools, "[{\"name\":\"get_weather\",\"description\":\"Get the weather\",\"schema\":\"{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"location\\\":{\\\"type\\\":\\\"string\\\"}},\\\"required\\\":[\\\"location\\\"]}\"},{\"name\":\"ping\",\"description\":\"\",\"schema\":\"{\\\"type\\\":\\\"object\\\",\\\"additionalProperties\\\":false}\"},{\"name\":\"odd\",\"description\":\"d\",\"schema\":\"{\\\"type\\\":\\\"object\\\"}\"}]");
    same(heap, cursor, "p2");
    let (t2, c2) = mcp.tools_page(heap, "{\"id\":2,\"result\":{\"tools\":[]}}", false);
    same(heap, t2, "[]");
    same(heap, c2, "");
    let (t3, c3) = mcp.tools_page(heap, "{\"id\":2,\"error\":{\"code\":1,\"message\":\"x\"}}", false);
    same(heap, t3, "[]");
    same(heap, c3, "");
    return 0;
}

fn texted[&h](heap: &!h Heap, line: &static [byte], want_error: bool, want: &static [byte]) -> [heap] int {
    let (err, text) = mcp.call_text(heap, line);
    test.assert(err == want_error);
    same(heap, text, want);
    return 0;
}

fn test_a_tool_result_is_text_for_the_model[&h](heap: &!h Heap) -> [heap] int {
    texted(heap, "{\"id\":2,\"result\":{\"resultType\":\"complete\",\"content\":[{\"type\":\"text\",\"text\":\"Sunny, 22C\"}],\"isError\":false}}", false, "Sunny, 22C");
    texted(heap, "{\"id\":2,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"one\"},{\"type\":\"image\",\"data\":\"AAAA\",\"mimeType\":\"image/png\"},{\"type\":\"audio\",\"data\":\"BBBB\",\"mimeType\":\"audio/wav\"},{\"type\":\"resource_link\",\"uri\":\"file:///a.txt\",\"name\":\"a\"},{\"type\":\"resource\",\"resource\":{\"uri\":\"x\"}},{\"type\":\"text\",\"text\":\"two \\\"quoted\\\"\"}]}}", false, "one\n[image]\n[audio]\n[resource file:///a.txt]\n[embedded resource]\ntwo \"quoted\"");
    texted(heap, "{\"id\":2,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"Invalid date: must be in the future\"}],\"isError\":true}}", true, "Invalid date: must be in the future");
    texted(heap, "{\"id\":2,\"result\":{\"content\":[],\"structuredContent\":{\"temperature\":22.5,\"tags\":[\"a\",true,null]}}}", false, "{\"temperature\":22.5,\"tags\":[\"a\",true,null]}");
    texted(heap, "{\"id\":2,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"t\"}],\"structuredContent\":{\"x\":1}}}", false, "t");
    texted(heap, "{\"id\":2,\"result\":{}}", false, "");
    texted(heap, "{\"id\":2,\"error\":{\"code\":-32602,\"message\":\"Unknown tool\"}}", false, "");
    return 0;
}

fn test_only_the_tools_that_say_they_only_read_can_be_asked_for[&h](heap: &!h Heap) -> [heap] int {
    let line = "{\"id\":2,\"result\":{\"tools\":[{\"name\":\"look\",\"description\":\"reads\",\"annotations\":{\"readOnlyHint\":true},\"inputSchema\":{\"type\":\"object\"}},{\"name\":\"change\",\"description\":\"writes\",\"annotations\":{\"readOnlyHint\":false},\"inputSchema\":{\"type\":\"object\"}},{\"name\":\"silent\",\"description\":\"says nothing\",\"inputSchema\":{\"type\":\"object\"}},{\"name\":\"odd\",\"description\":\"x\",\"annotations\":{\"readOnlyHint\":\"true\"},\"inputSchema\":{\"type\":\"object\"}},{\"name\":\"other\",\"description\":\"y\",\"annotations\":{\"destructiveHint\":false},\"inputSchema\":{\"type\":\"object\"}}]}}";
    let (only, c1) = mcp.tools_page(heap, line, true);
    same(heap, only, "[{\"name\":\"look\",\"description\":\"reads\",\"schema\":\"{\\\"type\\\":\\\"object\\\"}\"}]");
    buffer.drop(heap, c1);
    let (all, c2) = mcp.tools_page(heap, line, false);
    borrow all as &ab in {
        test.assert_eq(msg.call_count(heap, "{}"), 0);
        test.assert(len(buffer.bytes(ab)) > 300);
    }
    buffer.drop(heap, all);
    buffer.drop(heap, c2);
    return 0;
}

fn test_arrays_are_joined_and_names_prefixed[&h](heap: &!h Heap) -> [heap] int {
    same(heap, mcp.join_arrays(heap, "[1,2]", "[3]"), "[1,2,3]");
    same(heap, mcp.join_arrays(heap, "[]", "[3]"), "[3]");
    same(heap, mcp.join_arrays(heap, "[1]", "[]"), "[1]");
    same(heap, mcp.join_arrays(heap, "[]", "[]"), "[]");
    let tools = "[{\"name\":\"add\",\"description\":\"Add\",\"schema\":\"{}\"},{\"name\":\"x\",\"description\":\"\",\"schema\":\"{\\\"type\\\":\\\"object\\\"}\"}]";
    same(heap, mcp.prefixed(heap, tools, "mcp1_"), "[{\"name\":\"mcp1_add\",\"description\":\"Add\",\"schema\":\"{}\"},{\"name\":\"mcp1_x\",\"description\":\"\",\"schema\":\"{\\\"type\\\":\\\"object\\\"}\"}]");
    same(heap, mcp.prefixed(heap, "[]", "p_"), "[]");
    same(heap, mcp.prefixed(heap, "nope", "p_"), "[]");
    // a name that would be over 64 bytes is left out
    let long = "[{\"name\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"description\":\"\",\"schema\":\"{}\"},{\"name\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"description\":\"\",\"schema\":\"{}\"}]";
    same(heap, mcp.prefixed(heap, long, "mcp1_"), "[{\"name\":\"mcp1_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"description\":\"\",\"schema\":\"{}\"}]");
    return 0;
}

fn lines[&h](heap: &!h Heap, body: &static [byte], want: &static [byte]) -> [heap] int {
    same(heap, mcp.http_lines(heap, body), want);
    return 0;
}

fn test_a_json_answer_is_one_line_even_when_pretty_printed[&h](heap: &!h Heap) -> [heap] int {
    lines(heap, "{\"id\":1,\"result\":{}}", "{\"id\":1,\"result\":{}}\n");
    lines(heap, "\n  {\"id\":1,\n  \"result\":{}}\r\n", "{\"id\":1,   \"result\":{}}  \n");
    return 0;
}

fn test_an_event_stream_gives_one_line_per_event_with_data[&h](heap: &!h Heap) -> [heap] int {
    lines(heap, "id: 0\ndata:\n\nevent: message\nid: 1\ndata: {\"id\":1,\"result\":{}}\n\n", "{\"id\":1,\"result\":{}}\n");
    lines(heap, ": keep-alive\n\ndata: {\"method\":\"notifications/progress\"}\n\ndata: {\"id\":2,\"result\":{}}\n\n", "{\"method\":\"notifications/progress\"}\n{\"id\":2,\"result\":{}}\n");
    lines(heap, "data: {\"id\":3,\r\ndata: \"result\":{}}\r\n\r\n", "{\"id\":3, \"result\":{}}\n");
    lines(heap, "data:{\"id\":4}\n\n", "{\"id\":4}\n");
    lines(heap, "retry: 1000\nid: 5\n\n", "");
    return 0;
}

fn test_an_event_the_stream_ends_in_the_middle_of_is_still_read[&h](heap: &!h Heap) -> [heap] int {
    lines(heap, "data: {\"id\":6,\"result\":{}}", "{\"id\":6,\"result\":{}}\n");
    lines(heap, "data: {\"id\":6,\"result\":{}}\n", "{\"id\":6,\"result\":{}}\n");
    lines(heap, "data: {\"id\":6,\ndata: \"result\":{}}", "{\"id\":6, \"result\":{}}\n");
    lines(heap, "", "");
    return 0;
}

fn test_the_answer_inside_a_stream_is_found_by_its_id[&h](heap: &!h Heap) -> [heap] int {
    let l = mcp.http_lines(heap, "data: {\"method\":\"notifications/message\"}\n\ndata: {\"jsonrpc\":\"2.0\",\"id\":7,\"result\":{\"x\":1}}\n\n");
    borrow l as &lb in {
        let (k7, l7) = mcp.find_response(heap, buffer.bytes(lb), 7);
        test.assert_eq(k7, 1);
        buffer.drop(heap, l7);
        let (k8, l8) = mcp.find_response(heap, buffer.bytes(lb), 8);
        test.assert_eq(k8, 0);
        buffer.drop(heap, l8);
    }
    buffer.drop(heap, l);
    return 0;
}

fn test_the_headers_of_a_post_carry_what_the_spec_asks_of_each_era[&h](heap: &!h Heap) -> [heap] int {
    same(heap, mcp.http_headers(heap, "", "", "", "", ""), "Accept: application/json, text/event-stream\r\nContent-Type: application/json\r\n");
    same(heap, mcp.http_headers(heap, "", "2026-07-28", "tools/call", "add", ""), "Accept: application/json, text/event-stream\r\nContent-Type: application/json\r\nMCP-Protocol-Version: 2026-07-28\r\nMcp-Method: tools/call\r\nMcp-Name: add\r\n");
    same(heap, mcp.http_headers(heap, "", "2025-11-25", "", "", "s-1"), "Accept: application/json, text/event-stream\r\nContent-Type: application/json\r\nMCP-Protocol-Version: 2025-11-25\r\nMcp-Session-Id: s-1\r\n");
    same(heap, mcp.http_headers(heap, "Authorization: Bearer k\r\n", "2026-07-28", "tools/list", "", ""), "Accept: application/json, text/event-stream\r\nContent-Type: application/json\r\nMCP-Protocol-Version: 2026-07-28\r\nMcp-Method: tools/list\r\nAuthorization: Bearer k\r\n");
    return 0;
}

fn test_a_name_or_session_id_that_could_break_a_header_is_not_sent() -> [] int {
    test.assert(mcp.plain_name("get_weather"));
    test.assert(mcp.plain_name("a.b-c_d"));
    test.assert(!mcp.plain_name(""));
    test.assert(!mcp.plain_name("two words"));
    test.assert(!mcp.plain_name("café"));
    test.assert(!mcp.plain_name("x\r\nHost: evil"));
    test.assert(!mcp.plain_name("=?base64?YWJj?="));
    test.assert(mcp.visible_ascii("sess-abc123"));
    test.assert(mcp.visible_ascii(""));
    test.assert(!mcp.visible_ascii("a b"));
    test.assert(!mcp.visible_ascii("a\r\nb"));
    test.assert(!mcp.visible_ascii("é"));
    return 0;
}

import std.test;
import agent;

fn test_a_plain_answer_is_done() -> [] int {
    test.assert_eq(agent.decide(1, 4, 100, 1000, 0, 0), agent.d_done());
    return 0;
}

fn test_tools_are_run_while_there_are_steps() -> [] int {
    test.assert_eq(agent.decide(1, 4, 100, 1000, 1, 2), agent.d_run_tools());
    test.assert_eq(agent.decide(3, 4, 100, 1000, 1, 1), agent.d_run_tools());
    test.assert_eq(agent.decide(4, 4, 100, 1000, 1, 1), agent.d_too_many_steps());
    return 0;
}

fn test_a_spent_budget_stops_everything() -> [] int {
    test.assert_eq(agent.decide(1, 4, 1000, 1000, 0, 0), agent.d_out_of_budget());
    test.assert_eq(agent.decide(1, 4, 999, 1000, 0, 0), agent.d_done());
    test.assert_eq(agent.decide(1, 4, 5000, 1000, 1, 1), agent.d_out_of_budget());
    test.assert_eq(agent.decide(1, 4, 5000, 0, 0, 0), agent.d_done());
    return 0;
}

fn test_a_cut_answer_is_not_an_answer() -> [] int {
    test.assert_eq(agent.decide(1, 4, 10, 1000, 2, 0), agent.d_cut_off());
    test.assert_eq(agent.decide(1, 4, 10, 1000, 2, 1), agent.d_cut_off());
    return 0;
}

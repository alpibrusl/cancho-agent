edition 7;

module mock;

import std.buffer;
import std.json;
import msg;

// A model that is a script (cancho-agent, docs/design.md section 3): for tests of whatever uses an agent, with no network and no tokens. The script is text, one neutral assistant
// message per line (`{"role":"assistant","text":"..","calls":[..]}`, the lines `msg` writes). The answer to a conversation is the line numbered by how many assistant messages the conversation
// already holds, so the same script gives the same answers however often it is asked and whatever else is in the conversation: line 0 answers the first request, line 1 the request that
// follows its tool calls, and so on. A conversation that has used up the script gets no answer (ok = false), which is how a test makes the model fail. A line that is not a message
// also gets none. Nothing here reads the conversation but to count.

// How many assistant messages the conversation holds.
pub fn assistants[&h, &c](heap: &!h Heap, conv: &c [byte]) -> [heap] int {
    let tape = box_slice(heap, 3 * len(conv) + 3, 0);
    var tape_w = tape;
    var n = 0;
    borrow mut tape_w as &!tw in {
        let tp = contents(tw);
        if json.parse(conv, tp) >= 0 && json.is_array(tp, 0) {
            var k = 0;
            while k < json.count(tp, 0) {
                let m = json.at(tp, 0, k);
                if json.string_equals(conv, tp, json.get(conv, tp, m, "role"), "assistant") {
                    n = n + 1;
                }
                k = k + 1;
            }
        }
    }
    unbox_slice(heap, tape_w);
    return n;
}

// Line `k` of the script (without its line end), as (start, end), or (-1, -1).
fn line_range[&s](script: &s [byte], k: int) -> [] (int, int) {
    var start = 0;
    var seen = 0;
    var i = 0;
    while i <= len(script) {
        if i == len(script) || int_of(script[i]) == 10 {
            if i > start {
                if seen == k {
                    return (start, i);
                }
                seen = seen + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return (0 - 1, 0 - 1);
}

// The answer to a conversation: (ok, the assistant message, why it stopped (`msg.fin_*`), tokens used). Each answer is said to have cost 10 tokens.
pub fn reply[&h, &s, &c](heap: &!h Heap, script: &s [byte], conv: &c [byte]) -> [heap] (bool, buffer.Buffer, int, int) {
    let k = assistants(heap, conv);
    let (a, b) = line_range(script, k);
    if a < 0 {
        return (false, buffer.empty(heap, 8), msg.fin_other(), 0);
    }
    let line = script[a..b];
    var ok = false;
    var fin = msg.fin_other();
    let tape = box_slice(heap, 3 * len(line) + 3, 0);
    var tape_w = tape;
    borrow mut tape_w as &!tw in {
        let tp = contents(tw);
        if json.parse(line, tp) >= 0 && json.is_object(tp, 0) && json.string_equals(line, tp, json.get(line, tp, 0, "role"), "assistant") {
            ok = true;
            fin = msg.fin_stop();
            let calls = json.get(line, tp, 0, "calls");
            if calls >= 0 && json.is_array(tp, calls) && json.count(tp, calls) > 0 {
                fin = msg.fin_tools();
            }
        }
    }
    unbox_slice(heap, tape_w);
    if !ok {
        return (false, buffer.empty(heap, 8), msg.fin_other(), 0);
    }
    return (true, buffer.append(heap, buffer.empty(heap, len(line) + 1), line), fin, 10);
}

edition 7;

module mcp;

import std.buffer;
import std.bytes;
import std.json;
import msg;

// An MCP client's messages, pure (cancho-agent, docs/design.md section 6): build the JSON-RPC lines a client sends a server over stdio, and read what comes back. No process, no clock:
// `mcp_stdio` runs a server and carries these.
//
// Two eras of the protocol are spoken, because servers in the world are in both. Written from the specification as read on 2026-11-06 (revision 2026-07-28 and the legacy 2025-11-25),
// by a reader that fetched the pages, not from memory; checked here against a fake server written from the same reading, so **a real server is the real test and none has been tried yet**.
//   modern (2026-07-28)  there is no handshake: every request carries `_meta` with the protocol version and the client's capabilities; a server answers `server/discover`
//   legacy (2025-11-25)  `initialize` (protocolVersion, capabilities, clientInfo), the server's answer, then the notification `notifications/initialized`, then requests
// stdio framing is one JSON message per line, no embedded newline, no headers. Servers write only messages to stdout.

pub fn modern_version() -> [] &static [byte] {
    return "2026-07-28";
}

pub fn legacy_version() -> [] &static [byte] {
    return "2025-11-25";
}

// The two eras, and "find out".
pub fn era_modern() -> [] int {
    return 0;
}

pub fn era_legacy() -> [] int {
    return 1;
}

pub fn era_auto() -> [] int {
    return 2;
}

fn put_meta[&h](heap: &!h Heap, w: json.Writer) -> [heap] json.Writer {
    var o = json.put_key(heap, w, "_meta");
    o = json.begin_object(heap, o);
    o = json.put_key(heap, o, "io.modelcontextprotocol/protocolVersion");
    o = json.put_string(heap, o, modern_version());
    o = json.put_key(heap, o, "io.modelcontextprotocol/clientInfo");
    o = json.begin_object(heap, o);
    o = json.put_key(heap, o, "name");
    o = json.put_string(heap, o, "cancho-agent");
    o = json.put_key(heap, o, "version");
    o = json.put_string(heap, o, "0.1.0");
    o = json.end_object(heap, o);
    o = json.put_key(heap, o, "io.modelcontextprotocol/clientCapabilities");
    o = json.begin_object(heap, o);
    o = json.end_object(heap, o);
    return json.end_object(heap, o);
}

// The start of a request: `{"jsonrpc":"2.0","id":N,"method":"..","params":{` and, in the modern era, the `_meta` that every request carries.
fn open_request[&h, &m](heap: &!h Heap, id: int, method: &m [byte], modern: bool) -> [heap] json.Writer {
    var w = json.writer(heap, 256);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "jsonrpc");
    w = json.put_string(heap, w, "2.0");
    w = json.put_key(heap, w, "id");
    w = json.put_int(heap, w, id);
    w = json.put_key(heap, w, "method");
    w = json.put_string(heap, w, method);
    w = json.put_key(heap, w, "params");
    w = json.begin_object(heap, w);
    if modern {
        w = put_meta(heap, w);
    }
    return w;
}

fn close_request[&h](heap: &!h Heap, w: json.Writer) -> [heap] buffer.Buffer {
    var o = json.end_object(heap, w);
    o = json.end_object(heap, o);
    let b = json.finish(o);
    return buffer.push(heap, b, byte_of(10));
}

// `server/discover` (modern): a server that speaks the modern era answers with its versions and capabilities, any other answers an error.
pub fn discover[&h](heap: &!h Heap, id: int) -> [heap] buffer.Buffer {
    return close_request(heap, open_request(heap, id, "server/discover", true));
}

// `initialize` (legacy), and the notification that follows the server's answer.
pub fn initialize[&h](heap: &!h Heap, id: int) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 256);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "jsonrpc");
    w = json.put_string(heap, w, "2.0");
    w = json.put_key(heap, w, "id");
    w = json.put_int(heap, w, id);
    w = json.put_key(heap, w, "method");
    w = json.put_string(heap, w, "initialize");
    w = json.put_key(heap, w, "params");
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "protocolVersion");
    w = json.put_string(heap, w, legacy_version());
    w = json.put_key(heap, w, "capabilities");
    w = json.begin_object(heap, w);
    w = json.end_object(heap, w);
    w = json.put_key(heap, w, "clientInfo");
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "name");
    w = json.put_string(heap, w, "cancho-agent");
    w = json.put_key(heap, w, "version");
    w = json.put_string(heap, w, "0.1.0");
    w = json.end_object(heap, w);
    w = json.end_object(heap, w);
    w = json.end_object(heap, w);
    return buffer.push(heap, json.finish(w), byte_of(10));
}

pub fn initialized[&h](heap: &!h Heap) -> [heap] buffer.Buffer {
    return buffer.append(heap, buffer.empty(heap, 64), "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}\n");
}

// `tools/list`, from `cursor` (empty for the first page).
pub fn tools_list[&h, &c](heap: &!h Heap, id: int, modern: bool, cursor: &c [byte]) -> [heap] buffer.Buffer {
    var w = open_request(heap, id, "tools/list", modern);
    if len(cursor) > 0 {
        w = json.put_key(heap, w, "cursor");
        w = json.put_string(heap, w, cursor);
    }
    return close_request(heap, w);
}

// `tools/call` of `name` with `arguments`, JSON text (an object; empty or not an object is `{}`).
pub fn tools_call[&h, &n, &a](heap: &!h Heap, id: int, modern: bool, name: &n [byte], arguments: &a [byte]) -> [heap] buffer.Buffer {
    var w = open_request(heap, id, "tools/call", modern);
    w = json.put_key(heap, w, "name");
    w = json.put_string(heap, w, name);
    w = json.put_key(heap, w, "arguments");
    if len(arguments) > 1 && int_of(arguments[0]) == 123 {
        w = json.put_fragment(heap, w, arguments);
    } else {
        w = json.put_fragment(heap, w, "{}");
    }
    return close_request(heap, w);
}

// What the server wrote that answers request `id`: (0 nothing yet, 1 a result, 2 an error), and that line. Notifications (no id) and answers to other ids are not it; a line that is not
// JSON is not anything (a server may not write one, but one that does is ignored, not believed).
pub fn find_response[&h, &o](heap: &!h Heap, output: &o [byte], id: int) -> [heap] (int, buffer.Buffer) {
    var kind = 0;
    var found = buffer.empty(heap, 8);
    var start = 0;
    var i = 0;
    while i <= len(output) {
        if i == len(output) || int_of(output[i]) == 10 {
            if i > start && kind == 0 {
                let line = output[start..i];
                let tape = box_slice(heap, 3 * len(line) + 3, 0);
                var tape_w = tape;
                borrow mut tape_w as &!tw in {
                    let tp = contents(tw);
                    if json.parse(line, tp) >= 0 && json.is_object(tp, 0) {
                        let nid = json.get(line, tp, 0, "id");
                        if nid >= 0 && json.is_int(tp, nid) && json.to_int(line, tp, nid) == id {
                            if json.get(line, tp, 0, "result") >= 0 {
                                kind = 1;
                            } else if json.get(line, tp, 0, "error") >= 0 {
                                kind = 2;
                            }
                            if kind > 0 {
                                buffer.drop(heap, found);
                                found = buffer.append(heap, buffer.empty(heap, len(line) + 1), line);
                            }
                        }
                    }
                }
                unbox_slice(heap, tape_w);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return (kind, found);
}

// `<code>: <message>` of an error response.
pub fn error_text[&h, &l](heap: &!h Heap, line: &l [byte]) -> [heap] buffer.Buffer {
    let tape = box_slice(heap, 3 * len(line) + 3, 0);
    var tape_w = tape;
    var out = buffer.empty(heap, 16);
    borrow mut tape_w as &!tw in {
        let tp = contents(tw);
        if json.parse(line, tp) >= 0 && json.is_object(tp, 0) {
            let e = json.get(line, tp, 0, "error");
            if e >= 0 && json.is_object(tp, e) {
                let c = json.get(line, tp, e, "code");
                if c >= 0 && json.is_int(tp, c) {
                    out = buffer.append(heap, out, line[tp[3 * c + 1]..tp[3 * c + 2]]);
                    out = buffer.append(heap, out, ": ");
                }
                let m = msg.string_of(heap, line, tp, json.get(line, tp, e, "message"));
                borrow m as &mb in {
                    out = buffer.append(heap, out, buffer.bytes(mb));
                }
                buffer.drop(heap, m);
            }
        }
    }
    unbox_slice(heap, tape_w);
    return out;
}

// The tools of a `tools/list` result in the neutral form of `msg` (`[{"name","description","schema"}]`, the schema as a string), and the cursor of the next page (empty if none). With
// `read_only` only the tools that say `annotations.readOnlyHint: true` are kept: the operator of a server they trust decides to offer what only reads, and a tool that says nothing about it
// is taken to write (the specification says a client treats annotations as untrusted unless the server is trusted, which is why this is the operator's choice and not the model's).
pub fn tools_page[&h, &l](heap: &!h Heap, line: &l [byte], read_only: bool) -> [heap] (buffer.Buffer, buffer.Buffer) {
    let tape = box_slice(heap, 3 * len(line) + 3, 0);
    var tape_w = tape;
    var tools = msg.empty(heap);
    var cursor = buffer.empty(heap, 8);
    borrow mut tape_w as &!tw in {
        let tp = contents(tw);
        if json.parse(line, tp) >= 0 && json.is_object(tp, 0) {
            let r = json.get(line, tp, 0, "result");
            if r >= 0 && json.is_object(tp, r) {
                let list = json.get(line, tp, r, "tools");
                if list >= 0 && json.is_array(tp, list) {
                    var k = 0;
                    while k < json.count(tp, list) {
                        let t = json.at(tp, list, k);
                        var wanted = true;
                        if read_only {
                            wanted = false;
                            let an = json.get(line, tp, t, "annotations");
                            if an >= 0 && json.is_object(tp, an) {
                                let ro = json.get(line, tp, an, "readOnlyHint");
                                wanted = ro >= 0 && json.is_bool(tp, ro) && json.to_bool(tp, ro);
                            }
                        }
                        let name = msg.string_of(heap, line, tp, json.get(line, tp, t, "name"));
                        let desc = msg.string_of(heap, line, tp, json.get(line, tp, t, "description"));
                        var sw = json.writer(heap, 64);
                        let sch = json.get(line, tp, t, "inputSchema");
                        if sch >= 0 && json.is_object(tp, sch) {
                            sw = msg.put_node(heap, sw, line, tp, sch);
                        } else {
                            sw = json.put_fragment(heap, sw, "{\"type\":\"object\"}");
                        }
                        let schema = json.finish(sw);
                        borrow name as &nb in {
                            if wanted && len(buffer.bytes(nb)) > 0 {
                                borrow desc as &db in {
                                    borrow schema as &sb in {
                                        tools = msg.push(heap, tools, msg.tool_def(heap, buffer.bytes(nb), buffer.bytes(db), buffer.bytes(sb)));
                                    }
                                }
                            }
                        }
                        buffer.drop(heap, name);
                        buffer.drop(heap, desc);
                        buffer.drop(heap, schema);
                        k = k + 1;
                    }
                }
                let nc = json.get(line, tp, r, "nextCursor");
                if nc >= 0 && json.is_string(tp, nc) {
                    buffer.drop(heap, cursor);
                    cursor = msg.string_of(heap, line, tp, nc);
                }
            }
        }
    }
    unbox_slice(heap, tape_w);
    return (tools, cursor);
}

// The result of a `tools/call` as text for the model: the `text` items joined by newlines, a placeholder (`[image]`, `[audio]`, `[resource <uri>]`) for the others, the
// `structuredContent` as JSON when there is no text at all. `isError` is the tool's own failure, which the model is meant to see and correct; a protocol error is not a result.
pub fn call_text[&h, &l](heap: &!h Heap, line: &l [byte]) -> [heap] (bool, buffer.Buffer) {
    let tape = box_slice(heap, 3 * len(line) + 3, 0);
    var tape_w = tape;
    var is_error = false;
    var out = buffer.empty(heap, 16);
    var pieces = 0;
    borrow mut tape_w as &!tw in {
        let tp = contents(tw);
        if json.parse(line, tp) >= 0 && json.is_object(tp, 0) {
            let r = json.get(line, tp, 0, "result");
            if r >= 0 && json.is_object(tp, r) {
                let ie = json.get(line, tp, r, "isError");
                if ie >= 0 && json.is_bool(tp, ie) {
                    is_error = json.to_bool(tp, ie);
                }
                let content = json.get(line, tp, r, "content");
                if content >= 0 && json.is_array(tp, content) {
                    var k = 0;
                    while k < json.count(tp, content) {
                        let item = json.at(tp, content, k);
                        let ty = json.get(line, tp, item, "type");
                        if pieces > 0 {
                            out = buffer.push(heap, out, byte_of(10));
                        }
                        if json.string_equals(line, tp, ty, "text") {
                            let tx = msg.string_of(heap, line, tp, json.get(line, tp, item, "text"));
                            borrow tx as &xb in {
                                out = buffer.append(heap, out, buffer.bytes(xb));
                            }
                            buffer.drop(heap, tx);
                        } else if json.string_equals(line, tp, ty, "image") {
                            out = buffer.append(heap, out, "[image]");
                        } else if json.string_equals(line, tp, ty, "audio") {
                            out = buffer.append(heap, out, "[audio]");
                        } else if json.string_equals(line, tp, ty, "resource_link") {
                            let uri = msg.string_of(heap, line, tp, json.get(line, tp, item, "uri"));
                            out = buffer.append(heap, out, "[resource ");
                            borrow uri as &ub in {
                                out = buffer.append(heap, out, buffer.bytes(ub));
                            }
                            out = buffer.push(heap, out, byte_of(93));
                            buffer.drop(heap, uri);
                        } else {
                            out = buffer.append(heap, out, "[embedded resource]");
                        }
                        pieces = pieces + 1;
                        k = k + 1;
                    }
                }
                if pieces == 0 {
                    let sc = json.get(line, tp, r, "structuredContent");
                    if sc >= 0 {
                        var w = json.writer(heap, 64);
                        w = msg.put_node(heap, w, line, tp, sc);
                        let js = json.finish(w);
                        borrow js as &jb in {
                            out = buffer.append(heap, out, buffer.bytes(jb));
                        }
                        buffer.drop(heap, js);
                    }
                }
            }
        }
    }
    unbox_slice(heap, tape_w);
    return (is_error, out);
}

// `a` and `b` are JSON arrays; the array of both.
pub fn join_arrays[&h, &a, &b](heap: &!h Heap, a: &a [byte], b: &b [byte]) -> [heap] buffer.Buffer {
    if len(b) <= 2 {
        return buffer.append(heap, buffer.empty(heap, len(a) + 1), a);
    }
    if len(a) <= 2 {
        return buffer.append(heap, buffer.empty(heap, len(b) + 1), b);
    }
    var o = buffer.append(heap, buffer.empty(heap, len(a) + len(b)), a[0..len(a) - 1]);
    o = buffer.push(heap, o, byte_of(44));
    return buffer.append(heap, o, b[1..len(b)]);
}

// The neutral tools with `prefix` in front of every name (`mcp1_` + `add`), so the tools of several servers, and the tools of the program itself, cannot be mistaken for one another,
// and so that a call can be sent back to the server it belongs to. A name that would be over 64 bytes (what the providers take) is left out.
pub fn prefixed[&h, &t, &p](heap: &!h Heap, tools: &t [byte], prefix: &p [byte]) -> [heap] buffer.Buffer {
    let tape = box_slice(heap, 3 * len(tools) + 3, 0);
    var tape_w = tape;
    var out = msg.empty(heap);
    borrow mut tape_w as &!tw in {
        let tp = contents(tw);
        if json.parse(tools, tp) >= 0 && json.is_array(tp, 0) {
            var k = 0;
            while k < json.count(tp, 0) {
                let t = json.at(tp, 0, k);
                let name = msg.string_of(heap, tools, tp, json.get(tools, tp, t, "name"));
                let desc = msg.string_of(heap, tools, tp, json.get(tools, tp, t, "description"));
                let schema = msg.string_of(heap, tools, tp, json.get(tools, tp, t, "schema"));
                var full = buffer.append(heap, buffer.empty(heap, 64), prefix);
                borrow name as &nb in {
                    full = buffer.append(heap, full, buffer.bytes(nb));
                }
                borrow full as &fb in {
                    if len(buffer.bytes(fb)) <= 64 {
                        borrow desc as &db in {
                            borrow schema as &sb in {
                                out = msg.push(heap, out, msg.tool_def(heap, buffer.bytes(fb), buffer.bytes(db), buffer.bytes(sb)));
                            }
                        }
                    }
                }
                buffer.drop(heap, full);
                buffer.drop(heap, name);
                buffer.drop(heap, desc);
                buffer.drop(heap, schema);
                k = k + 1;
            }
        }
    }
    unbox_slice(heap, tape_w);
    return out;
}

// What an HTTP server answered, as the lines `find_response` reads: one JSON message per line. A body that opens with `{` is one JSON message (its raw line breaks are whitespace, so a
// pretty-printed answer is still one line). Anything else is read as a Server-Sent Events stream (`text/event-stream`): the `data:` lines of an event, joined by a space, are one
// message; comments (`:`), `event:`, `id:` and `retry:` lines are ignored, and an event with no data (the priming event of a resumable stream) is nothing. CRLF and LF both end a
// line; an event that the stream ends in the middle of is still read. The spec names no event type for the final answer, so the answer is the message whose id matches.
pub fn http_lines[&h, &o](heap: &!h Heap, body: &o [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, len(body) + 2);
    var first = 0;
    while first < len(body) && (int_of(body[first]) == 32 || int_of(body[first]) == 9 || int_of(body[first]) == 10 || int_of(body[first]) == 13) {
        first = first + 1;
    }
    if first < len(body) && int_of(body[first]) == 123 {
        var k = first;
        while k < len(body) {
            if int_of(body[k]) == 10 || int_of(body[k]) == 13 {
                out = buffer.push(heap, out, byte_of(32));
            } else {
                out = buffer.push(heap, out, body[k]);
            }
            k = k + 1;
        }
        return buffer.push(heap, out, byte_of(10));
    }
    var ev = buffer.empty(heap, 64);
    var have = false;
    var start = 0;
    var j = 0;
    while j <= len(body) {
        if j == len(body) || int_of(body[j]) == 10 {
            var end = j;
            if end > start && int_of(body[end - 1]) == 13 {
                end = end - 1;
            }
            let line = body[start..end];
            if len(line) == 0 || j == len(body) {
                if j == len(body) && len(line) > 0 && len(line) >= 5 && bytes.equal(line[0..5], "data:") {
                    var f = 5;
                    if f < len(line) && int_of(line[f]) == 32 {
                        f = f + 1;
                    }
                    if have {
                        ev = buffer.push(heap, ev, byte_of(32));
                    }
                    ev = buffer.append(heap, ev, line[f..len(line)]);
                    have = true;
                }
                borrow ev as &eb in {
                    if len(buffer.bytes(eb)) > 0 {
                        out = buffer.append(heap, out, buffer.bytes(eb));
                        out = buffer.push(heap, out, byte_of(10));
                    }
                }
                buffer.drop(heap, ev);
                ev = buffer.empty(heap, 64);
                have = false;
            } else if len(line) >= 5 && bytes.equal(line[0..5], "data:") {
                var f = 5;
                if f < len(line) && int_of(line[f]) == 32 {
                    f = f + 1;
                }
                if have {
                    ev = buffer.push(heap, ev, byte_of(32));
                }
                ev = buffer.append(heap, ev, line[f..len(line)]);
                have = true;
            }
            start = j + 1;
        }
        j = j + 1;
    }
    buffer.drop(heap, ev);
    return out;
}

// The header lines of a POST, each ending CRLF. An empty `version`, `method`, `name` or `sid` leaves its line out; `extra` (the caller's own lines, an `Authorization: Bearer` among
// them) goes last and is written as given.
pub fn http_headers[&h, &e, &v, &m, &n, &s](heap: &!h Heap, extra: &e [byte], version: &v [byte], method: &m [byte], name: &n [byte], sid: &s [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 256), "Accept: application/json, text/event-stream\r\nContent-Type: application/json\r\n");
    if len(version) > 0 {
        b = buffer.append(heap, b, "MCP-Protocol-Version: ");
        b = buffer.append(heap, b, version);
        b = buffer.append(heap, b, "\r\n");
    }
    if len(method) > 0 {
        b = buffer.append(heap, b, "Mcp-Method: ");
        b = buffer.append(heap, b, method);
        b = buffer.append(heap, b, "\r\n");
    }
    if len(name) > 0 {
        b = buffer.append(heap, b, "Mcp-Name: ");
        b = buffer.append(heap, b, name);
        b = buffer.append(heap, b, "\r\n");
    }
    if len(sid) > 0 {
        b = buffer.append(heap, b, "Mcp-Session-Id: ");
        b = buffer.append(heap, b, sid);
        b = buffer.append(heap, b, "\r\n");
    }
    return buffer.append(heap, b, extra);
}

// Is `name` printable ASCII with nothing the header could be confused by? (The modern spec has a base64 form for the rest; it is not built, so such a name is refused.)
pub fn plain_name[&k](name: &k [byte]) -> [] bool {
    if len(name) == 0 || len(name) > 128 {
        return false;
    }
    var i = 0;
    while i < len(name) {
        let c = int_of(name[i]);
        if c < 33 || c > 126 {
            return false;
        }
        i = i + 1;
    }
    if len(name) >= 9 && bytes.equal(name[0..9], "=?base64?") {
        return false;
    }
    return true;
}

// Is `text` visible ASCII (0x21 to 0x7E), or empty? What a session id must be to be written into a header line.
pub fn visible_ascii[&k](text: &k [byte]) -> [] bool {
    if len(text) == 0 {
        return true;
    }
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 33 || c > 126 {
            return false;
        }
        i = i + 1;
    }
    return true;
}


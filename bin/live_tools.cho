edition 9;

import std.buffer;
import std.bytes;
import std.io;
import anthropic;
import msg;
import openai;
import std.json;
import agent;
import transport;

// live_tools <anthropic|mistral|local> <key-file> <roots.pem> <host> <ip> <model> <question>: one question to a real model with a tool (`add`), the loop run until it answers, the transcript on standard output. For trying the adapters by
// hand; the tests that use it are opt-in (CANCHO_AGENT_LIVE=1) and are not part of the normal run.

fn say[&i, &t](io: &!i Io, text: &t [byte]) -> [io_write] int {
    return io.write_all(io, text);
}

fn slurp[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], cap: int) -> [heap, fs_read("")] (buffer.Buffer, bool) {
    let store = box_slice(heap, cap, byte_of(0));
    var out = buffer.empty(heap, 16);
    var ok = false;
    borrow mut store as &!sw in {
        let n = fs_read(fs, path, contents(sw));
        if n >= 0 {
            ok = true;
            out = buffer.append(heap, out, contents(sw)[0..n]);
        }
    }
    unbox_slice(heap, store);
    return (out, ok);
}



// The one tool: add {"a":int,"b":int}.
fn add_tool[&h, &a](heap: &!h Heap, args: &a [byte]) -> [heap] buffer.Buffer {
    let tape = box_slice(heap, 3 * len(args) + 3, 0);
    var tape_w = tape;
    var out = buffer.append(heap, buffer.empty(heap, 16), "error: bad arguments");
    borrow mut tape_w as &!tw in {
        let tp = contents(tw);
        if json.parse(args, tp) >= 0 && json.is_object(tp, 0) {
            let a = json.get(args, tp, 0, "a");
            let b = json.get(args, tp, 0, "b");
            if a >= 0 && b >= 0 && json.is_int(tp, a) && json.is_int(tp, b) {
                buffer.drop(heap, out);
                out = buffer.push_nat(heap, buffer.empty(heap, 16), json.to_int(args, tp, a) + json.to_int(args, tp, b));
            }
        }
    }
    unbox_slice(heap, tape_w);
    return out;
}

fn go[&h, &f, &n, &c, &i, &g](heap: &!h Heap, fs: &f Fs(""), net: &n Net(""), clock: &c Clock, io: &!i Io, args: &g Args) -> [heap, args, fs_read(""), net_out(""), conn_read, conn_write, poll, clock, io_write] int {
    if arg_count(args) < 8 {
        say(io, "usage: live_tools <anthropic|mistral> <key-file> <roots.pem> <host> <ip> <model> <question>\n");
        return 2;
    }
    let is_anthropic = bytes.equal(arg(args, 1), "anthropic");
    let (key_raw, kok) = slurp(heap, fs, arg(args, 2), 4096);
    let (roots, rok) = slurp(heap, fs, arg(args, 3), 4194304);
    if !kok || !rok {
        say(io, "cannot read the key or the roots\n");
        buffer.drop(heap, key_raw);
        buffer.drop(heap, roots);
        return 2;
    }
    var headers = buffer.empty(heap, 256);
    if is_anthropic {
        headers = buffer.append(heap, headers, "x-api-key: ");
    } else {
        headers = buffer.append(heap, headers, "Authorization: Bearer ");
    }
    borrow key_raw as &kr in {
        var e = len(buffer.bytes(kr));
        while e > 0 && (int_of(buffer.bytes(kr)[e - 1]) == 10 || int_of(buffer.bytes(kr)[e - 1]) == 13 || int_of(buffer.bytes(kr)[e - 1]) == 32) {
            e = e - 1;
        }
        headers = buffer.append(heap, headers, buffer.bytes(kr)[0..e]);
    }
    buffer.drop(heap, key_raw);
    if is_anthropic {
        headers = buffer.append(heap, headers, "\r\nanthropic-version: 2023-06-01\r\nContent-Type: application/json\r\n");
    } else {
        headers = buffer.append(heap, headers, "\r\nContent-Type: application/json\r\n");
    }
    var entropy = box_slice(heap, 32, byte_of(0));
    borrow mut entropy as &!ew in {
        fs_read(fs, "/dev/urandom", contents(ew));
    }
    var tools = msg.empty(heap);
    tools = msg.push(heap, tools, msg.tool_def(heap, "add", "Add two integers", "{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"integer\"},\"b\":{\"type\":\"integer\"}},\"required\":[\"a\",\"b\"]}"));
    var conv = msg.empty(heap);
    conv = msg.push(heap, conv, msg.text_message(heap, "system", "Use the add tool for any sum. Answer in one short sentence."));
    conv = msg.push(heap, conv, msg.text_message(heap, "user", arg(args, 7)));
    var path = "/v1/chat/completions";
    if is_anthropic {
        path = "/v1/messages";
    }
    var steps = 0;
    var tokens = 0;
    var rc = 1;
    var going = true;
    while going {
        steps = steps + 1;
        var body = buffer.empty(heap, 16);
        borrow conv as &cb in {
            borrow tools as &tb in {
                buffer.drop(heap, body);
                if is_anthropic {
                    body = anthropic.request(heap, arg(args, 6), 300, buffer.bytes(cb), buffer.bytes(tb));
                } else {
                    body = openai.request(heap, arg(args, 6), 300, buffer.bytes(cb), buffer.bytes(tb));
                }
            }
        }
        var got = false;
        var m = buffer.empty(heap, 8);
        var fin = 3;
        var spent = 0;
        borrow body as &bb in {
            borrow headers as &hb in {
                borrow roots as &rb in {
                    borrow mut entropy as &!ew in {
                        match transport.exchange(heap, net, clock, io, arg(args, 4), 443, true, path, buffer.bytes(hb), buffer.bytes(bb), buffer.bytes(rb), arg(args, 5), contents(ew), 33554432, 120000) {
                            transport.Answered::Ok(status, out) => {
                                borrow out as &ob in {
                                    if is_anthropic {
                                        let (o2, m2, f2, a2, b2) = anthropic.reply(heap, buffer.bytes(ob));
                                        got = o2;
                                        buffer.drop(heap, m);
                                        m = m2;
                                        fin = f2;
                                        spent = a2 + b2;
                                    } else {
                                        let (o3, m3, f3, a3, b3) = openai.reply(heap, buffer.bytes(ob));
                                        got = o3;
                                        buffer.drop(heap, m);
                                        m = m3;
                                        fin = f3;
                                        spent = a3 + b3;
                                    }
                                    if !got {
                                        say(io, "not an answer: ");
                                        say(io, buffer.bytes(ob));
                                        say(io, "\n");
                                    }
                                }
                                buffer.drop(heap, out);
                            }
                            transport.Answered::Failed(tag) => {
                                say(io, "the transport failed: ");
                                say(io, transport.tag_of(tag));
                                say(io, "\n");
                            }
                        }
                    }
                }
            }
        }
        buffer.drop(heap, body);
        tokens = tokens + spent;
        if !got {
            buffer.drop(heap, m);
            going = false;
        } else {
            var ncalls = 0;
            borrow m as &mb in {
                ncalls = msg.call_count(heap, buffer.bytes(mb));
                say(io, "step ");
                var sl = buffer.push_nat(heap, buffer.empty(heap, 8), steps);
                borrow sl as &slb in {
                    say(io, buffer.bytes(slb));
                }
                buffer.drop(heap, sl);
                say(io, ": ");
                say(io, buffer.bytes(mb));
                say(io, "\n");
            }
            let d = agent.decide(steps, 4, tokens, 5000, fin, ncalls);
            if d == agent.d_run_tools() {
                var k = 0;
                var results = buffer.empty(heap, 16);
                borrow m as &mb in {
                    while k < ncalls {
                        let (id, name, cargs) = msg.call_at(heap, buffer.bytes(mb), k);
                        borrow id as &idb in {
                            borrow name as &nmb in {
                                borrow cargs as &cab in {
                                    let r = add_tool(heap, buffer.bytes(cab));
                                    borrow r as &rb2 in {
                                        let tm = msg.tool_message(heap, buffer.bytes(idb), buffer.bytes(nmb), buffer.bytes(rb2));
                                        results = msg.push(heap, results, tm);
                                    }
                                    buffer.drop(heap, r);
                                }
                            }
                        }
                        buffer.drop(heap, id);
                        buffer.drop(heap, name);
                        buffer.drop(heap, cargs);
                        k = k + 1;
                    }
                }
                conv = msg.push(heap, conv, m);
                // the results: one message per call, appended in order
                borrow results as &resb in {
                    let tape = box_slice(heap, 3 * len(buffer.bytes(resb)) + 3, 0);
                    var tape_w = tape;
                    borrow mut tape_w as &!tw in {
                        let tp = contents(tw);
                        if json.parse(buffer.bytes(resb), tp) >= 0 {
                            var q = 0;
                            while q < json.count(tp, 0) {
                                let node = json.at(tp, 0, q);
                                let id = msg.string_of(heap, buffer.bytes(resb), tp, json.get(buffer.bytes(resb), tp, node, "id"));
                                let nm = msg.string_of(heap, buffer.bytes(resb), tp, json.get(buffer.bytes(resb), tp, node, "name"));
                                let tx = msg.string_of(heap, buffer.bytes(resb), tp, json.get(buffer.bytes(resb), tp, node, "text"));
                                borrow id as &i1 in {
                                    borrow nm as &n1 in {
                                        borrow tx as &t1 in {
                                            conv = msg.push(heap, conv, msg.tool_message(heap, buffer.bytes(i1), buffer.bytes(n1), buffer.bytes(t1)));
                                        }
                                    }
                                }
                                buffer.drop(heap, id);
                                buffer.drop(heap, nm);
                                buffer.drop(heap, tx);
                                q = q + 1;
                            }
                        }
                    }
                    unbox_slice(heap, tape_w);
                }
                buffer.drop(heap, results);
            } else {
                buffer.drop(heap, m);
                if d == agent.d_done() {
                    rc = 0;
                } else {
                    say(io, "stopped\n");
                }
                going = false;
            }
        }
    }
    buffer.drop(heap, conv);
    buffer.drop(heap, tools);
    buffer.drop(heap, headers);
    buffer.drop(heap, roots);
    unbox_slice(heap, entropy);
    return rc;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(tty);
    release(ffi);
    release(signals);
    release(exec);
    var console = io;
    var h = heap;
    var rc = 1;
    borrow args as &g in {
        borrow net as &n in {
            borrow clock as &c in {
                borrow fs as &f in {
                    borrow mut console as &!i in {
                        borrow mut h as &!hh in {
                            rc = go(hh, f, n, c, i, g);
                        }
                    }
                }
            }
        }
    }
    release(net);
    release(clock);
    release(fs);
    release(console);
    release(h);
    release(args);
    return rc;
}

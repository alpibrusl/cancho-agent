edition 9;

import std.buffer;
import std.bytes;
import std.io;
import mcp;
import mcp_stdio;

// mcp_probe <server command> <modern|legacy|auto> list
// mcp_probe <server command> <modern|legacy|auto> call <tool> [<arguments, JSON>]
// Talk to an MCP server over stdio from a terminal (cancho-agent, docs/design.md section 6): the tools it offers, or one call. The server command is run by /bin/sh -c, one process per request.
// The answer is printed; the exit code is 0 for an answer that is not an error, 1 for a tool that failed or a server that did not answer, 2 for a bad command line.

fn say[&i, &t](io: &!i Io, text: &t [byte]) -> [io_write] int {
    return io.write_all(io, text);
}

fn run[&h, &c, &x, &i, &g](heap: &!h Heap, clock: &c Clock, exec: &x Exec(""), io: &!i Io, args: &g Args) -> [heap, args, clock, poll, exec(""), io_write] int {
    if arg_count(args) < 4 {
        say(io, "usage: mcp_probe <server command> <modern|legacy|auto> list | call <tool> [<arguments>]\n");
        return 2;
    }
    var era = mcp.era_auto();
    if bytes.equal(arg(args, 2), "modern") {
        era = mcp.era_modern();
    } else if bytes.equal(arg(args, 2), "legacy") {
        era = mcp.era_legacy();
    } else if !bytes.equal(arg(args, 2), "auto") {
        say(io, "the era is modern, legacy or auto\n");
        return 2;
    }
    if bytes.equal(arg(args, 3), "list") {
        let (code, tools) = mcp_stdio.list_tools(heap, clock, exec, arg(args, 1), era, 20000);
        borrow tools as &tb in {
            say(io, buffer.bytes(tb));
        }
        say(io, "\n");
        buffer.drop(heap, tools);
        if code == mcp_stdio.ok() {
            return 0;
        }
        say(io, "the server did not give its tools\n");
        return 1;
    }
    if bytes.equal(arg(args, 3), "call") && arg_count(args) >= 5 {
        var arguments = "{}";
        if arg_count(args) >= 6 {
            arguments = arg(args, 5);
        }
        let (code, failed, text) = mcp_stdio.call_tool(heap, clock, exec, arg(args, 1), era, arg(args, 4), arguments, 20000);
        borrow text as &xb in {
            say(io, buffer.bytes(xb));
        }
        say(io, "\n");
        buffer.drop(heap, text);
        if failed {
            return 1;
        }
        return 0;
    }
    say(io, "list, or call <tool> [<arguments>]\n");
    return 2;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(signals);
    release(tty);
    release(net);
    release(fs);
    var status = 1;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow clock as &c in {
                borrow exec as &x in {
                    borrow mut io as &!i in {
                        status = run(h, c, x, i, g);
                    }
                }
            }
        }
    }
    release(heap);
    release(args);
    release(clock);
    release(exec);
    release(io);
    return status;
}
